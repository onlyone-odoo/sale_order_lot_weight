<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_detailed_operation_tree_inherit_lot_weight" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.inherit.lot.weight</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree/field[@name='lot_name']" position="after">
                <field name="weight" readonly="lot_id != False" groups="stock.group_production_lot" sum="Peso Total"/>
            </xpath>
        </field>
    </record>
</odoo>