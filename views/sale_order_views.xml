<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_lot_weight" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.lot.weight</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="after">
                <field name="lot_ids" widget="many2many_tags" options="{'color_field': 'company_id','no_create': True}"/>
                <field name="total_weight" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>