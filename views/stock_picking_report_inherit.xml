<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_compact" inherit_id="stock.report_picking">
        <xpath expr="//div[@class='page']/div[1]" position="replace">
            <div class="row">
                <div class="col-4">
                    <strong>Dirección de envío:</strong><br/>
                    <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name", "street", "city"], "no_marker": True}'/>
                </div>
                <div class="col-4 text-center">
                    <h1 style="margin: 0; font-size: 2.2em;">
                        <strong t-field="o.name"/>
                    </h1>
                </div>
                <div class="col-4 text-end">
                    <div t-field="o.name" t-options='{"widget": "barcode", "width": 300, "height": 60}'/>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-4">
                    <strong>Orden:</strong> <span t-field="o.origin"/>
                </div>
                <div class="col-4 text-center">
                    <strong>Fecha programada:</strong> <span t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                </div>
                <div class="col-4 text-end">
                    <h3 style="margin: 0; color: #2c3e50;">
                        <strong>
                            Cajas: <span t-esc="len(o.move_line_ids)"/> |
                            Peso Total:
                            <span t-esc="sum((ml.weight or 0.0) for ml in o.move_line_ids)"
                                  t-options='{"widget": "float", "precision": 3}'/> kg
                        </strong>
                    </h3>
                </div>
            </div>
        </xpath>
        <!-- Eliminar direcciones duplicadas -->
        <xpath expr="//div[@name='div_outgoing_address']" position="replace"/>
        <xpath expr="//h1[@class='mt0']" position="replace"/>
        <!-- Quitar solo las clases mt32 mb32 del row, manteniendo el div -->
        <xpath expr="//div[@class='row mt32 mb32']" position="attributes">
            <attribute name="class">row</attribute>
        </xpath>
        <!-- Tabla compacta: Producto | Detalles (lote , peso, lote , peso, ...) -->
        <xpath expr="//table[@class='table table-sm']" position="replace">
            <t t-set="grouped_lines" t-value="{}"/>
            <t t-foreach="o.move_line_ids.sorted(lambda ml: ml.product_id.display_name)" t-as="ml">
                <t t-set="product_key" t-value="ml.product_id.id"/>
                <t t-if="product_key not in grouped_lines">
                    <t t-set="_dummy" t-value="grouped_lines.update({product_key: {'name': ml.product_id.display_name, 'lots': [], 'weights': []}})"/>
                </t>
                <t t-set="_dummy" t-value="grouped_lines[product_key]['lots'].append(ml.lot_id.name or ml.lot_name or '—')"/>
                <t t-set="_dummy" t-value="grouped_lines[product_key]['weights'].append('%.3f kg' % (ml.weight or 0.0))"/>
            </t>
            <table class="table table-sm table-bordered" style="font-size: 10px;">
                <thead class="thead-light">
                    <tr>
                        <th><strong>Producto</strong></th>
                        <th><strong>Detalles (Lote , Peso)</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="grouped_lines.values()" t-as="group">
                        <tr>
                            <td><span t-esc="group['name']"/></td>
                            <td style="white-space: pre-wrap; word-wrap: break-word;">
                                <strong t-esc="', '.join(['%s , %s' % (lot, weight) for lot, weight in zip(group['lots'], group['weights'])])"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
