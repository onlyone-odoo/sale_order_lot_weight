<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stock_picking_report_custom" inherit_id="stock.report_picking">

        <!-- 1. Columna Peso (KG) -->
        <xpath expr="//th[@name='th_product']" position="after">
            <th name="th_weight" class="text-end">
                <strong>Weight (KG)</strong>
            </th>
        </xpath>

        <!-- 2. Celda peso por línea -->
        <xpath expr="//td[span[@t-field='ml.product_id.display_name']]" position="after">
            <td name="td_weight" class="text-end">
                <span t-field="ml.weight" t-options='{"widget": "float", "precision": 3}'/>
                <span t-if="ml.weight"> kg</span>
            </td>
        </xpath>

        <!-- 3. ELIMINAR COLUMNA QUANTITY DE FORMA SEGURA (el truco definitivo que NUNCA falla) -->
        <xpath expr="//th[strong[text()='Quantity']]" position="replace"/>

        <!-- 4. ELIMINAR TODA LA CELDA DE CANTIDAD (incluyendo packaging) -->
        <xpath expr="//td[span[@t-field='ml.quantity']]" position="replace"/>

        <!-- 5. Simplificar Lot/Serial Number → solo texto -->
        <xpath expr="//td[@t-if='has_serial_number' and contains(@class, 'text-center')]" position="replace">
            <td class="text-center" t-if="has_serial_number">
                <span t-esc="ml.lot_id.name or ml.lot_name"/>
            </td>
        </xpath>

        <!-- 6. Totales encima de la tabla -->
        <xpath expr="//table[thead/tr/th[@name='th_product']]" position="before">
            <t t-set="total_weight" t-value="sum((ml.weight or 0.0) for ml in o.move_line_ids_without_package or [])"/>
            <t t-set="total_packages" t-value="len(o.move_line_ids_without_package or [])"/>

            <div class="row mb-4 mt-5">
                <div class="col-12 text-end">
                    <strong style="font-size: 1.4em; color: #212529;">
                        Total Packages: <span t-esc="total_packages"/>
                        | Total Weight: 
                        <span t-esc="total_weight" t-options='{"widget": "float", "precision": 3}'/> kg
                    </strong>
                </div>
            </div>
        </xpath>

    </template>
</odoo>