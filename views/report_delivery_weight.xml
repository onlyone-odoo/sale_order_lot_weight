<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Header pendientes -->
        <template id="w17_pending_header" inherit_id="stock.report_delivery_document">
            <xpath expr="//table[@name='stock_move_table']//th[@name='th_sm_product']" position="after">
                <th class="text-end"><strong>Weight (KG)</strong></th>
            </xpath>
        </template>
        <template id="w17_pending_lines" inherit_id="stock.report_delivery_document">
            <xpath expr="//table[@name='stock_move_table']//td[1]" position="after">
                <td class="text-end">-</td>
            </xpath>
        </template>

        <!-- Header entregadas -->
        <template id="w17_done_header" inherit_id="stock.report_delivery_document">
            <xpath expr="//table[@name='stock_move_line_table']//th[@name='th_sml_product']" position="after">
                <th class="text-end"><strong>Weight (KG)</strong></th>
            </xpath>
        </template>

        <!-- Líneas con lote/serial (XMLID correcto en v17) -->
        <template id="w17_serial_line" inherit_id="stock.report_delivery_document_has_serial_move_line">
            <xpath expr="//td[span[@t-field='move_line.product_id']]" position="after">
                <td class="text-end">
                    <span t-field="move_line.weight" t-options="{'widget': 'float', 'precision': 2}"/>
                    <t t-if="move_line.weight"> kg</t>
                </td>
            </xpath>
        </template>

        <!-- Líneas agregadas -->
        <template id="w17_aggregated_line" inherit_id="stock.report_delivery_aggregated_move_lines">
            <xpath expr="//td[span[@t-field='line.product_id']]" position="after">
                <td class="text-end">
                    <t t-set="first_ml" t-value="line['move_lines'][:1]"/>
                    <span t-if="first_ml" t-field="first_ml.weight" t-options="{'widget': 'float', 'precision': 2}"/>
                    <t t-if="first_ml and first_ml.weight"> kg</t>
                </td>
            </xpath>
        </template>

        <!-- Backorders -->
        <template id="w17_backorder" inherit_id="stock.report_delivery_document">
            <xpath expr="//table[@name='stock_backorder_table']//th[@name='th_sb_product']" position="after">
                <th class="text-end"><strong>Weight (KG)</strong></th>
            </xpath>
            <xpath expr="//table[@name='stock_backorder_table']//td[1]" position="after">
                <td class="text-end">-</td>
            </xpath>
        </template>

        <!-- Colspan paquetes -->
        <template id="w17_colspan" inherit_id="stock.report_delivery_document">
            <xpath expr="//td[@t-attf-colspan='3']" position="attributes">
                <attribute name="colspan">4</attribute>
            </xpath>
        </template>

    </data>
</odoo>