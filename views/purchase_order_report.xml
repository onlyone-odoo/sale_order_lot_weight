<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_weight" inherit_id="purchase.report_purchaseorder_document">
        <!-- Header: columna después de Qty -->
        <xpath expr="//thead/tr/th[@name='th_quantity']" position="after">
            <th class="text-end"><strong>Purchased Weight (KG)</strong></th>
        </xpath>

        <!-- Body: td después del td de Qty (el que contiene product_qty) -->
        <xpath expr="//tbody//td[span[@t-field='line.product_qty']]" position="after">
            <td class="text-end">
                <span t-field="line.purchase_weight" t-options='{"widget": "float", "precision": 3}'/>
            </td>
        </xpath>
    </template>
</odoo>