<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_weight" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//thead/tr" position="inside">
            <th name="th_purchase_weight" class="text-end"><strong>Purchased Weight (KG)</strong></th>
        </xpath>

        <xpath expr="//tbody/tr[not(@t-if)]/td[@name='th_quantity']" position="after">
            <td name="td_purchase_weight" class="text-end">
                <span t-field="line.purchase_weight" t-options='{"widget": "float", "precision": 3}'/>
            </td>
        </xpath>

    </template>
</odoo>